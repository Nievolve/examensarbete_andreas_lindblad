{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "structured_text",
      "camelcase": "StructuredText",
      "title": "Structured Text",
      "scope": "source.se",
      "file-types": [
        "st"
      ],
      "injection-regex": "^structured_text$",
      "class-name": "TreeSitterStructuredText"
    }
  ],
  "metadata": {
    "version": "0.0.1",
    "license": "MIT",
    "description": "For IEC 61131-3 language Structured Text",
    "authors": [
      {
        "name": "Andreas Lindblad",
        "email": "andreaslindblad@protonmail.com",
        "url": "-"
      }
    ],
    "links": {
      "repository": "https://github.com/Nievolve/structured_text_Tree-sitter",
      "funding": "-"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}